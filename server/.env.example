# Server Configuration
PORT=5000

# MongoDB Connection String (Replace with your actual local or Atlas URI in .env)
# Local example: mongodb://127.0.0.1:27017/dogfood_hackathon
# Atlas example: mongodb+srv://<username>:<password>@cluster.mongodb.net/dogfood_hackathon?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/dogfood_hackathon

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
